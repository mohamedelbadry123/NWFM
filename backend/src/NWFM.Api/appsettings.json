{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NWFM;Integrated Security=True;TrustServerCertificate=True"
  },
  "Application": {
    "TenantId": "10000000-0000-0000-0000-000000000001",
    "TenantName": "NWFM"
  },
  // What the API may do to the Auth database on start. Defaults below match the
  // reference app (production-safe seed off). Development turns SeedData on.
  "DatabaseStartup": {
    "ApplyMigrations": true,
    "SeedData": true,
    "ApplySqlObjects": true
  },
  "WorkflowSettings": {
    "IsEnabled": true
  },
  "WorkflowDemo": {
    "Enabled": false
  },
  // Closing C2M field activities when a task of a closing task type is approved. Off by default:
  // with Enabled=false every closure is recorded as SKIPPED. Credentials come from user secrets or
  // environment variables (C2m__Username, C2m__Password), never from this file.
  "C2m": {
    "Enabled": false,
    "ByPassClosingInCcb": false,
    "BaseUrl": "",
    "UserId": "SPNWCALLDP",
    "SourceApp": "WFM",
    "ImageUrlTemplate": "",
    "TimeoutSeconds": 30,
    "WaitForAcknowledgement": true,
    "AcknowledgementTimeoutSeconds": 15,
    "RetryIntervalSeconds": 300,
    "MaxAttempts": 5
  },
  "FormEngine": {
    // The calendar a form's date rules are judged against — a fill records a local date, not an instant.
    "TimeZoneId": "Asia/Riyadh",
    // Enforce each field's required/length/pattern/numeric/choice rules on submit.
    "EnforceFieldRules": true
  },
  "FileStorage": {
    // Relative paths resolve under the API's content root. Excluded from source control.
    "Root": "Media",
    "PendingFolder": "pending",
    "SubmissionsFolder": "forms",
    "MaxFileSizeMb": 50,
    // Empty means any type; entries may be exact ("image/png") or a prefix ("image/*").
    "AllowedContentTypes": []
  },
  "JwtSettings": {
    "Issuer": "NWFM",
    "Audience": "NWFM.Admin",
    "SigningKey": "REPLACE_WITH_USER_SECRET_OR_ENV_VAR_min_32_chars",
    "ExpiryMinutes": 600,
    "RefreshTokenExpiryDays": 7
  },
  "Sso": {
    "Enabled": false,
    "AllowLocalLoginForAdministrators": true,
    "EntityId": "",
    "ModulePath": "/api/v1/auth/sso/saml",
    "AssertionConsumerServiceUrl": "",
    "CallbackUrl": "",
    "IdentityProviderEntityId": "",
    "IdentityProviderMetadataUrl": "",
    "LogoutUrl": "",
    "CertPfxFile": "",
    "CertPfxPassword": "",
    "ClientAppBaseUrl": "http://localhost:4200",
    "AuthorizationCodeLifetimeSeconds": 60
  },
  "ActiveDirectory": {
    "Enabled": false,
    "Domain": "",
    "Server": "",
    "Port": 0,
    "UseSsl": true,
    "UseStartTls": false,
    "TrustServerCertificate": false,
    "UserNameFormat": "UserPrincipalName",
    "NetBiosName": "",
    "UserPrincipalNameSuffix": "",
    "TimeoutSeconds": 15
  },
  "TeamOtp": {
    "Enabled": true,
    "CodeLength": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MessageTemplateAr": "\u0631\u0645\u0632 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0647\u0648 {0}",
    "MessageTemplateEn": "Your login verification code is {0}"
  },
  "ExternalConsumers": {
    "WFM": [],
    "C2M": [],
    "Internal": [],
    "Mob": []
  },
  "ApiSecurity": {
    "EnableIpWhitelist": false,
    "EnableXForwardHeader": false,
    "IpWhitelist": [ "127.0.0.1", "::1" ]
  },
  "CacheSettings": {
    "Provider": "InMemory",
    "InstanceName": "nwfm",
    "DistributedConnection": "",
    "DefaultExpirationMinutes": 30,
    "DefaultLocalExpirationMinutes": 5,
    "LookupExpirationMinutes": 60,
    "MaximumPayloadBytes": 4194304,
    "Redis": {
      "Username": "default",
      "Password": "",
      "ConnectRetry": 2,
      "ConnectTimeoutMs": 5000,
      "Ssl": false,
      "AbortOnConnectFail": false,
      "Database": 0,
      "EndPoints": []
    }
  },
  "CorsOrigins": [ "http://localhost:4200" ],
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
