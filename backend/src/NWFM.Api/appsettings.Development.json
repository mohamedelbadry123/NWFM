{
  // acme.localhost:4200 is tenant "acme"; localhost itself is the bootstrap "nwfm" workspace's host.
  "Tenancy": {
    "RootDomain": "localhost",
    "AllowTenantHeader": true
  },
  "DatabaseStartup": {
    "InitializeOnly": false,
    "ApplyMigrations": false,
    "SeedData": false,
    "ApplySqlObjects": false
  },
  "JwtSettings": {
    "SigningKey": "NWFM-dev-signing-key-minimum-32-chars-long!"
  },
  "Sso": {
    "Enabled": false
  },
  "ActiveDirectory": {
    "Enabled": false
  },
  "TeamOtp": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
