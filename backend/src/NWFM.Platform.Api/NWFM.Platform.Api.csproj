<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The control plane: tenants, plans, self-service subscription requests and provisioning, support
    access and platform staff. Owns the catalog's migrations and migrates every tenant database. It
    references the module infrastructure (to migrate, seed and create administrators) but none of the
    module HTTP surfaces: tenant traffic is served by NWFM.Api only.
  -->
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Modules/Platform/Platform.Api/Platform.Api.csproj" />
    <ProjectReference Include="../Modules/Platform/Platform.Infrastructure/Platform.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/FormEngine/FormEngine.Infrastructure/FormEngine.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Tasks/Tasks.Infrastructure/Tasks.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Workflow/Workflow.Infrastructure/Workflow.Infrastructure.csproj" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
</Project>
