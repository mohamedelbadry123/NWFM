{
  // The platform reaches tenant databases as their OWNER. The tenant API reaches the same databases
  // under the same connection names as the restricted runtime login (nwfm_request).
  "ConnectionStrings": {
    "CatalogConnection": "Server=localhost;Database=NWFM_Catalog;Integrated Security=True;TrustServerCertificate=True",
    "DefaultConnection": "Server=localhost;Database=NWFM;Integrated Security=True;TrustServerCertificate=True"
  },
  // acme.localhost:4200 is tenant "acme". Locally the platform migrates every tenant on start.
  "Tenancy": {
    "RootDomain": "localhost",
    "MigrateTenantsOnStartup": true,
    "ConfigurationTenants": [
      {
        // The existing local workspace, adopted under the id its database is already bound to.
        "Id": "10000000-0000-0000-0000-000000000001",
        "Key": "nwfm",
        "Name": "NWFM",
        "ConnectionStringName": "DefaultConnection",
        "RuntimePrincipal": "nwfm_request",
        // Relative paths resolve against each host's content root; only the tenant API stores media.
        "StoragePath": "../NWFM.Api/Media",
        "Hosts": ["localhost", "127.0.0.1"],
        "ContactName": "Local Administrator",
        "ContactEmail": "administrator@localhost",
        "PlanCode": "enterprise",
        "SeedProfile": "Bootstrap"
      }
    ]
  },
  "Platform": {
    "AllowPrivateNetworkDatabaseHosts": true,
    "BootstrapAdmin": {
      "Email": "platform@localhost",
      "Password": "PlatformAdmin1!",
      "DisplayName": "NWFM Platform"
    }
  },
  "PlatformJwt": {
    "SigningKey": "DEV-ONLY-nwfm-platform-key-use-user-secrets-min-32-chars!!"
  },
  // Development e-mails are written to files at the repository root; each link is in its file.
  "Email": {
    "Enabled": true,
    "UseMock": true,
    "MockFolder": "../../../data/emails"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
