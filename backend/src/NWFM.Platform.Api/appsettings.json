{
  // Secrets: user-secrets (dev) or environment variables (servers). Never commit real values.
  // CatalogConnection is the control plane's own database. Any other name is a configuration tenant's
  // database, referenced by name from the catalog and reached here with the OWNER credential.
  "ConnectionStrings": {
    "CatalogConnection": "SET_VIA_USER_SECRETS_OR_ENV"
  },
  // The catalog always migrates and seeds here. Tenant databases are migrated by the console's
  // migrate actions, or on start where Tenancy:MigrateTenantsOnStartup is true.
  "DatabaseStartup": {
    "ApplyMigrations": true,
    "SeedData": true,
    "ApplySqlObjects": true
  },
  "Tenancy": {
    "RootDomain": "",
    "SnapshotRefreshSeconds": 30,
    // Production runs tenant migrations from the console or the deploy pipeline, not on every restart.
    "MigrateTenantsOnStartup": false,
    // Tenants whose database is named in configuration (see TenancyOptions). Empty in production
    // unless an existing single-tenant deployment is being adopted.
    "ConfigurationTenants": []
  },
  "Platform": {
    // The platform web app: landing, signup, and the e-mail verification link.
    "PublicAppBaseUrl": "http://localhost:4300",
    "ConsoleUrl": "http://localhost:4300/console",
    // A tenant's sign-in URL, sent in its activation e-mail and used for the support handoff.
    "TenantAppUrlTemplate": "http://{key}.localhost:4200",
    "EgressIps": [],
    "ManagedDatabaseNamePrefix": "nwfm_t_",
    "DefaultPlanCode": "trial",
    "SignupEmailTokenHours": 48,
    // A confirmed self-service signup waits on /console/signups until staff approve it.
    "RequireSignupApproval": true,
    "AdminActivationHours": 72,
    "MaxSupportGrantHours": 72,
    "SupportSessionMinutes": 60,
    "SupportHandoffSeconds": 60,
    "AllowPrivateNetworkDatabaseHosts": false,
    "Captcha": {
      "Provider": "None",
      "SiteKey": "",
      "SecretKey": ""
    },
    // First platform administrator, created only while the catalog has none. Password via user
    // secrets / Platform__BootstrapAdmin__Password; sign in, change it, then remove it.
    "BootstrapAdmin": {
      "Email": "",
      "Password": "",
      "DisplayName": "Platform Administrator"
    }
  },
  // Platform staff tokens. Never shared with the tenant API, which holds only its own JwtSettings key.
  "PlatformJwt": {
    "Issuer": "NWFM.Platform",
    "Audience": "NWFM.Platform",
    "SigningKey": "",
    "ExpiryMinutes": 120
  },
  // Signup verification and activation e-mails.
  "Email": {
    "Enabled": false,
    "UseMock": false,
    "MockFolder": "logs/emails",
    "Smtp": "",
    "Port": 587,
    "EmailFrom": "",
    "EmailFromPassword": "",
    "EnableSsl": true,
    "SenderName": "NWFM"
  },
  // Must match the tenant API: tenant seeding (the workflow Tenant row, the demo) runs Workflow handlers.
  "WorkflowSettings": {
    "IsEnabled": true
  },
  "WorkflowDemo": {
    "Enabled": false
  },
  "FileStorage": {
    "Root": "Media",
    "MaxFileSizeMb": 50,
    "AllowedContentTypes": []
  },
  "CacheSettings": {
    "Provider": "InMemory",
    // Must differ from the tenant API's instance name.
    "InstanceName": "nwfm-platform",
    "DefaultExpirationMinutes": 30,
    "DefaultLocalExpirationMinutes": 5,
    "LookupExpirationMinutes": 60,
    "MaximumPayloadBytes": 4194304
  },
  "KnownProxies": [],
  "CorsOrigins": ["http://localhost:4300"],
  "Urls": "http://localhost:5180",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
