<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The control plane's HTTP surface: platform staff endpoints (api/v1/platform) and the anonymous
    landing/signup endpoints (api/v1/public). Mapped by NWFM.Platform.Api only.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Application\Platform.Application.csproj" />
  </ItemGroup>
</Project>
