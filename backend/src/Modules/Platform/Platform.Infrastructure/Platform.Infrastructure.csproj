<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The control plane's infrastructure: the platform staff bearer scheme, signup provisioning
    (managed and bring-your-own databases), tenant migrations, the startup initialiser, and the
    catalog's EF migrations. Reaches tenant databases only through the modules' registered
    ITenantDatabaseModule and Auth's Identity store, each inside a tenant scope.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Application\Platform.Application.csproj" />
    <ProjectReference Include="..\..\Tenancy\Tenancy.Infrastructure\Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Auth\Auth.Infrastructure\Auth.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NWFM.Tests" />
  </ItemGroup>
</Project>
