<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tasks.Application\Tasks.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped inside the assembly: most hosts have no font with Arabic glyphs, and QuestPDF would
         print empty boxes. The OFL texts travel with the fonts they license. -->
    <EmbeddedResource Include="Reports\Fonts\*.ttf" LogicalName="Tasks.Reports.Fonts.%(Filename)%(Extension)" />
    <None Include="Reports\Fonts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NWFM.Tests" />
  </ItemGroup>

</Project>
