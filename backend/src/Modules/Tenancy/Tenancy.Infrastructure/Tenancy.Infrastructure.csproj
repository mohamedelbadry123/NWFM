<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The part of the master catalog both hosts need at runtime: tenant resolution, connection
    strings, the Data Protection key ring, support-access consent and the platform audit trail.
    Catalog migrations belong to the control plane (Platform.Infrastructure).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tenancy.Application\Tenancy.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Infrastructure" />
    <InternalsVisibleTo Include="NWFM.Tests" />
  </ItemGroup>
</Project>
