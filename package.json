{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@e2e-dev/web": "0.14.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "ai": "7.0.137",
    "angular-eslint": "21.4.0",
    "e2e": "0.19.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "zod": "4.6.6"
  },
  "scripts": {
    "test:e2e": "node scripts/e2e/run.mjs",
    "prepare": "husky",
    "quality:check": "node scripts/quality/check-files.mjs",
    "test:tooling": "node --test scripts/quality/*.test.mjs",
    "test:unit": "npm run test:tooling && node scripts/quality/test-unit.mjs",
    "test:frontend": "node scripts/quality/test-frontend.mjs",
    "test:backend": "dotnet test backend/NWFM.sln --configuration Release --logger trx",
    "build:frontend": "npm --prefix frontend run build:prod",
    "build:backend": "dotnet build backend/NWFM.sln --configuration Release",
    "test:e2e:replay": "NWFM_E2E_REPLAY=1 node scripts/e2e/run.mjs --strict-cache --reporter list,junit",
    "typecheck": "tsc --noEmit",
    "security:dependencies": "node scripts/quality/audit.mjs"
  },
  "name": "nwfm-quality",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3 <23"
  }
}
