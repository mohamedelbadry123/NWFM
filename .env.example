# Local Docker deployment only. Never commit the populated .env.
# Each tenant needs a different Compose project, tenant ID, passwords and signing key.
NWFM_COMPOSE_PROJECT=nwfm-local
NWFM_TENANT_ID=10000000-0000-0000-0000-000000000001
# Fill all secrets with independently generated random values.
# SQL passwords: 32-128 characters from A-Z, a-z, 0-9, _, !, -; include upper/lower/digits.
NWFM_SQL_PASSWORD=
NWFM_RUNTIME_PASSWORD=
# At least 32 random bytes, encoded as base64 or hex.
NWFM_JWT_SIGNING_KEY=
