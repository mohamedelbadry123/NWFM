# Local Docker deployment only. Never commit the populated .env.
# start-docker.bat creates .env from this file and fills every empty secret on its first run.
NWFM_COMPOSE_PROJECT=nwfm-local
# The bootstrap workspace's id. It is bound into its database and must never change.
NWFM_TENANT_ID=10000000-0000-0000-0000-000000000001
# The SQL Server installed on the host (mixed authentication, TCP enabled). It is not a container.
NWFM_SQL_HOST=host.docker.internal
NWFM_SQL_PORT=1433
# The control plane's owner login. start-docker.bat creates it on the host's default instance
# with your Windows identity; it never resets the password of an existing login.
NWFM_SQL_OWNER_USER=nwfm_docker_owner
# Fill all secrets with independently generated random values.
# SQL passwords: 32-128 characters from A-Z, a-z, 0-9, _, !, -; include upper/lower/digits.
NWFM_SQL_OWNER_PASSWORD=
NWFM_RUNTIME_PASSWORD=
NWFM_CATALOG_READER_PASSWORD=
# At least 32 random bytes each, encoded as base64 or hex. The two keys must differ: a workspace
# token must never validate on the control plane, nor a staff token on a workspace.
NWFM_JWT_SIGNING_KEY=
NWFM_PLATFORM_JWT_SIGNING_KEY=
# The first platform administrator (platform@localhost). Change it after the first sign-in.
NWFM_PLATFORM_ADMIN_PASSWORD=
